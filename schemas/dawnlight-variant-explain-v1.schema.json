{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dawnlight.dev/schemas/variant-explain-v1.schema.json",
  "title": "Dawnlight Program Variant Explanation v1",
  "description": "Payload returned by dawnlight/explainVariant.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "programId", "kind", "active", "variantFingerprint", "sourceFiles", "inputs", "defines", "includes", "graphNodeIds"],
  "properties": {
    "contractVersion": {"const": 1},
    "programId": {"type": "string", "minLength": 1},
    "kind": {"enum": ["graphics", "compute"]},
    "active": {"type": "boolean"},
    "inactiveReason": {"type": "string", "minLength": 1},
    "compileMode": {"type": "string", "minLength": 1},
    "variantFingerprint": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "sourceFiles": {"type": "array", "items": {"$ref": "#/$defs/sourceFile"}},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["options", "capabilities"],
      "properties": {
        "options": {"type": "array", "items": {"$ref": "#/$defs/input"}},
        "capabilities": {"type": "array", "items": {"$ref": "#/$defs/input"}}
      }
    },
    "defines": {"type": "array", "items": {"$ref": "#/$defs/define"}},
    "includes": {"type": "array", "items": {"$ref": "#/$defs/include"}},
    "graphNodeIds": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "stage": {"enum": ["vertex", "fragment", "geometry", "compute", "task", "mesh", "service", "host", "unknown"]},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["manifest", "fragment", "shader", "catalog", "generated", "runtime"]},
        "file": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$)).+"},
        "pointer": {"type": "string", "pattern": "^(?:|/(?:[^~]|~[01])*)$"},
        "symbol": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "file"],
      "properties": {
        "stage": {"$ref": "#/$defs/stage"},
        "file": {"type": "string", "minLength": 1},
        "entryPoint": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "scalar": {"type": ["string", "number", "boolean", "null"]},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value", "source"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "value": {"$ref": "#/$defs/scalar"},
        "source": {"enum": ["request", "default", "catalog", "runtime"]},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "defineSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["literal", "option", "capability", "engineDefault", "runtime"]},
        "id": {"type": "string", "minLength": 1},
        "inputValue": {"$ref": "#/$defs/scalar"},
        "mapped": {"type": "boolean"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "define": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "defined", "source"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "defined": {"type": "boolean"},
        "value": {"$ref": "#/$defs/scalar"},
        "source": {"$ref": "#/$defs/defineSource"},
        "reason": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "include": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "includedBy": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    }
  }
}

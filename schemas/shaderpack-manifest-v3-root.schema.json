{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "shaderpack-manifest-v3-root.schema.json",
  "title": "Dawnlight Manifest v3 Root",
  "description": "A single-file or composed Dawnlight shader-pack Manifest v3 root.",
  "oneOf": [
    {"$ref": "#/definitions/singleFile"},
    {"$ref": "#/definitions/composed"}
  ],
  "definitions": {
    "definitionProperties": {
      "options": {
        "type": "array",
        "items": {"$ref": "shaderpack-manifest-v3-fragment.schema.json#/definitions/option"}
      },
      "resources": {
        "type": "array",
        "items": {"$ref": "shaderpack-manifest-v3-fragment.schema.json#/definitions/resource"}
      },
      "programs": {
        "type": "array",
        "items": {"$ref": "shaderpack-manifest-v3-fragment.schema.json#/definitions/program"}
      },
      "passes": {
        "type": "array",
        "items": {"$ref": "shaderpack-manifest-v3-fragment.schema.json#/definitions/pass"}
      }
    },
    "singleFile": {
      "type": "object",
      "required": ["manifestVersion", "id", "name", "version"],
      "properties": {
        "manifestVersion": {"const": 3, "description": "Dawnlight Manifest format version."},
        "id": {"$ref": "shaderpack-common.schema.json#/definitions/identifier"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "author": {"type": "string"},
        "description": {"type": "string"},
        "shaderRoot": {"$ref": "shaderpack-common.schema.json#/definitions/path"},
        "settings": {"$ref": "shaderpack-common.schema.json#/definitions/path"},
        "options": {"$ref": "#/definitions/definitionProperties/options"},
        "resources": {"$ref": "#/definitions/definitionProperties/resources"},
        "programs": {"$ref": "#/definitions/definitionProperties/programs"},
        "passes": {"$ref": "#/definitions/definitionProperties/passes"}
      },
      "additionalProperties": false
    },
    "composed": {
      "type": "object",
      "required": ["sourceFormatVersion", "manifestVersion", "id", "name", "version", "fragments"],
      "properties": {
        "sourceFormatVersion": {"const": 1},
        "manifestVersion": {"const": 3, "description": "Dawnlight Manifest format version."},
        "id": {"$ref": "shaderpack-common.schema.json#/definitions/identifier"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "author": {"type": "string"},
        "description": {"type": "string"},
        "shaderRoot": {"$ref": "shaderpack-common.schema.json#/definitions/path"},
        "settings": {"$ref": "shaderpack-common.schema.json#/definitions/path"},
        "fragments": {
          "description": "Manifest fragment files loaded in declaration order.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "shaderpack-common.schema.json#/definitions/path"}
        }
      },
      "additionalProperties": false
    }
  }
}

{
  "name": "dawnlight-shader-pack-tools",
  "displayName": "Dawnlight Shader Pack Tools",
  "description": "JSON authoring support for Dawnlight shader packs.",
  "version": "0.1.0",
  "publisher": "dawnlight-dev",
  "private": true,
  "license": "MIT",
  "main": "./dist/extension.js",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "vscode": ">=1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "Survivalcraft",
    "Dawnlight",
    "shader",
    "shaderpack",
    "JSON"
  ],
  "repository": {
    "type": "git",
    "url": "https://example.invalid/dawnlight-core"
  },
  "activationEvents": [
    "workspaceContains:**/shaderpack.json"
  ],
  "scripts": {
    "build": "tsc -b && npm run bundle",
    "bundle": "esbuild packages/vscode-extension/src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js && esbuild packages/language-server/src/server.ts --bundle --platform=node --format=cjs --main-fields=module,main --outfile=dist/server.js",
    "package": "npm run build && vsce package --no-dependencies",
    "lint": "node test/quality-check.cjs",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run test:unit",
    "test:unit": "npm run build && node --test test/schema.test.cjs test/completion.test.cjs test/file-match.test.cjs test/snippet.test.cjs test/v2/contracts.test.cjs test/v2/catalog.test.cjs test/v2/language-server.test.cjs test/v2/workspace-discovery.test.cjs test/v2/language-server-workspace.test.cjs test/v2/composition.test.cjs test/v2/symbol-index.test.cjs test/v2/dynamic-completion.test.cjs test/v2/navigation.test.cjs test/v2/diagnostics.test.cjs",
    "test:vscode": "npm run build && node test/run-vscode.cjs",
    "test:vsix": "node test/run-vsix-acceptance.cjs",
    "test:all": "npm run test:unit && npm run test:vscode && npm run test:vsix"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.2",
    "ajv": "^8.17.1",
    "esbuild": "^0.25.11",
    "jsonc-parser": "^3.3.1",
    "mocha": "^11.7.1",
    "typescript": "^5.9.3",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageclient": "^9.0.1",
    "vscode-json-languageservice": "^5.4.3",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "contributes": {
    "configuration": {
      "title": "Dawnlight Shader Pack",
      "properties": {
        "dawnlight.shaderPack.catalog.path": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional path to an external Catalog Snapshot v1. Invalid or incompatible files fall back to the bundled Dawnlight Catalog."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "**/shaderpack.json"
        ],
        "url": "./schemas/shaderpack-manifest-v3-root.schema.json"
      },
      {
        "fileMatch": [
          "**/manifest/options/*.json",
          "**/manifest/resources/*.json",
          "**/manifest/passes/*.json",
          "**/manifest/programs/*.json"
        ],
        "url": "./schemas/shaderpack-manifest-v3-fragment.schema.json"
      },
      {
        "fileMatch": [
          "**/manifest/ui/settings.json"
        ],
        "url": "./schemas/shaderpack-settings-ui-v1.schema.json"
      }
    ],
    "snippets": [
      {
        "language": "json",
        "path": "./snippets/shaderpack.code-snippets"
      },
      {
        "language": "jsonc",
        "path": "./snippets/shaderpack.code-snippets"
      }
    ]
  }
}
